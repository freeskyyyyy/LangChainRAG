# ============================================================
#  配置文件模板（.env.example）
#
#  使用方法：把本文件复制一份、改名为 .env，然后填入真实的值
#  注意：.env 已被 .gitignore 排除，永远不会被提交到代码仓库
#        本模板文件（.env.example）不含任何密钥，可以安全提交
# ============================================================

# ---------------- 应用基础 ----------------
APP_NAME=企业级RAG知识库问答系统
APP_ENV=development
DEBUG=true

# JWT 签名密钥：登录令牌的「防伪印章」
# 生成方法（在项目根目录执行）：
#   .venv/Scripts/python.exe -c "import secrets;print(secrets.token_urlsafe(48))"
# 注意：改了它，所有已登录用户都会掉线，需要重新登录
SECRET_KEY=请填入一串随机字符串
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------- 阿里云百炼 (DashScope) ----------------
# 获取方式：https://bailian.console.aliyun.com → API-KEY 管理
DASHSCOPE_API_KEY=sk-请填入你的密钥

# 对话模型（负责生成回答）
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.3

# 向量化模型（把文字变成可检索的数字坐标）
EMBEDDING_MODEL=text-embedding-v4

# 重排序模型（对检索结果精排，提升准确率）
RERANK_MODEL=gte-rerank-v2

# ---------------- 数据库 ----------------
# 当前使用 SQLite：数据库就是 data/app.db 这一个文件，无需安装任何软件
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 将来若要切换到 MySQL，只需把上面一行注释掉、改用它（需先装好 MySQL 并建库）：
# DATABASE_URL=mysql+aiomysql://用户名:密码@localhost:3306/rag_kb?charset=utf8mb4

# ---------------- 向量库 ----------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=ec_product_kb

# ---------------- RAG 检索参数 ----------------
CHUNK_SIZE=500                 # 子块大小（字数）：用于检索，越小越精准
CHUNK_OVERLAP=80               # 相邻子块的重叠字数，避免切断语义
PARENT_CHUNK_SIZE=1400         # 父块大小（字数）：用于喂给模型，越大上下文越完整
RETRIEVAL_TOP_K=20             # 初筛召回条数
RERANK_TOP_N=5                 # 精排后最终采用条数
MAX_CONTEXT_CHUNKS=5           # 拼进提示词的最大片段数

# ---- 相关性阈值（必须设两个！）----
# 低于阈值就直接回答「知识库中未找到」，防止模型瞎编。
#
# ⚠️ 为什么是两个：重排序分数和向量相似度的量纲完全不同，
#    用同一个阈值去卡两种分数，必然有一种会被误判。
#
#    实测数据（12 个有答案的问题 + 6 个无答案的问题）：
#      重排序分数：有答案 0.167~0.320 | 无答案 0.006~0.160  ← 分界清晰
#      向量相似度：有答案 0.582~2.407 | 无答案 0.265~1.360  ← 严重重叠
#
#    如果拿 0.3 去卡重排序分数，正确答案（0.167）会被拦掉，
#    导致"知识库明明有答案却回答没找到"。
RERANK_SCORE_THRESHOLD=0.15    # 重排序分数阈值（实测分界线在 0.163）
SCORE_THRESHOLD=0.35           # 向量相似度阈值（重排序关闭时的降级路径用）

# ---------------- 缓存 ----------------
# memory = 程序内存缓存（当前方案，零安装）
# redis  = 将来部署到服务器时可切换（需先装 Redis）
CACHE_BACKEND=memory
SEMANTIC_CACHE_THRESHOLD=0.95  # 相似度超过多少才算「同一个问题」，可直接命中缓存
SEMANTIC_CACHE_TTL=3600        # 语义缓存存活秒数
RETRIEVAL_CACHE_TTL=600        # 检索结果缓存存活秒数

# ---------------- 限流防刷 ----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20       # 每个用户每分钟最多提问次数

# ---------------- 文件上传 ----------------
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.xlsx,.xls,.csv,.md,.txt,.html,.htm

# ---------------- 初始管理员账号 ----------------
# 首次启动时会自动创建这个账号，之后可以改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# ---------------- 日志 ----------------
LOG_LEVEL=INFO
LOG_DIR=./data/logs
